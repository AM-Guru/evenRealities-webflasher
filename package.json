{
  "name": "evenrealities-webflasher",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://am-guru.github.io/evenRealities-webflasher/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AM-Guru/evenRealities-webflasher.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "hardware": "npm run build && vite preview --host 127.0.0.1 --port 3000 --strictPort",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "test": "node --test tests/*.test.mjs",
    "test:python": "python3 -m unittest -v scripts/test_g2_flash_tools.py",
    "check": "npm run test && npm run build",
    "validate:pages": "node scripts/validate-pages-build.mjs",
    "archive:firmware": "node scripts/build-firmware-archive.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.0.2",
    "vite": "8.1.5"
  }
}
